{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "demo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/demo/tsconfig.json",
            "index": "projects/demo/src/index.html",
            "browser": "projects/demo/src/main.ts",
            "outputPath": "dist/demo",
            "styles": ["projects/demo/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "probe": {
      "projectType": "application",
      "root": "projects/probe",
      "sourceRoot": "projects/probe/src",
      "prefix": "probe",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/probe/tsconfig.json",
            "index": "projects/probe/src/index.html",
            "browser": "projects/probe/src/main-none.ts",
            "outputPath": "dist/probes/none",
            "outputHashing": "none",
            "optimization": true,
            "sourceMap": false
          },
          "configurations": {
            "none": {},
            "request": {
              "browser": "projects/probe/src/main-request.ts",
              "outputPath": "dist/probes/request"
            },
            "keyed": {
              "browser": "projects/probe/src/main-keyed.ts",
              "outputPath": "dist/probes/keyed"
            },
            "full": {
              "browser": "projects/probe/src/main-full.ts",
              "outputPath": "dist/probes/full"
            },
            "devtools": {
              "browser": "projects/probe/src/main-devtools.ts",
              "outputPath": "dist/probes/devtools"
            }
          },
          "defaultConfiguration": "none"
        }
      }
    },
    "queue-e2e": {
      "projectType": "application",
      "root": "projects/queue-e2e",
      "sourceRoot": "projects/queue-e2e/src",
      "prefix": "queue-e2e",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/queue-e2e/tsconfig.json",
            "index": "projects/queue-e2e/src/index.html",
            "browser": "projects/queue-e2e/src/main.ts",
            "outputPath": "dist/queue-e2e"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "signal-request": {
      "projectType": "library",
      "root": "projects/signal-request",
      "sourceRoot": "projects/signal-request/src",
      "prefix": "sr",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/signal-request/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/signal-request/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/signal-request/tsconfig.spec.json",
            "include": ["**/*.spec.ts", "../devtools/**/*.spec.ts", "../persist/**/*.spec.ts"],
            "coverage": true,
            "coverageReporters": ["text-summary"],
            "coverageThresholds": {
              "statements": 90,
              "branches": 85,
              "functions": 90,
              "lines": 90
            }
          }
        }
      }
    }
  }
}
