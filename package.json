{
  "name": "ng-signal-request",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build signal-request",
    "watch": "ng build signal-request --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc -p projects/signal-request/tsconfig.lib.json --noEmit && tsc -p projects/signal-request/tsconfig.spec.json --noEmit && tsc -p projects/demo/tsconfig.json --noEmit",
    "start": "ng serve demo",
    "build:demo": "ng build demo",
    "check:dist": "node scripts/check-dist.mjs",
    "check:api": "node scripts/api-diff.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:demo && pnpm run check:dist"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.0",
    "vitest": "^5.0.4"
  }
}
